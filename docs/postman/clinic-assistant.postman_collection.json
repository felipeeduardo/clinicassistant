        { "name": "Buscar agenda", "request": { "method": "GET", "url": "{{baseUrl}}/api/appointments/search?page=1&pageSize=25" } },
        { "name": "Criar agendamento", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const response = pm.response.json();", "pm.test('Agendamento é criado', () => { pm.expect(pm.response.code).to.eql(201); pm.expect(response.id).to.be.a('string'); });", "pm.collectionVariables.set('appointmentId', response.id);"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }], "body": { "mode": "raw", "raw": "{\n  \"clinicUnitId\": \"{{unitId}}\",\n  \"professionalId\": \"{{professionalId}}\",\n  \"specialtyId\": \"{{specialtyId}}\",\n  \"patientId\": \"{{patientId}}\",\n  \"startsAt\": \"2026-08-10T12:00:00-03:00\",\n  \"endsAt\": \"2026-08-10T12:30:00-03:00\",\n  \"source\": \"Postman\",\n  \"notes\": \"Fluxo operacional de teste\"\n}" }, "url": "{{baseUrl}}/api/appointments" } },
