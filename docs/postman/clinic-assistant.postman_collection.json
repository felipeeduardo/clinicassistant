    {
      "name": "01 — Authentication",
      "description": "Registro inicial, login, sessão, renovação e logout.",
      "item": [
        {
          "name": "Registrar clínica e administrador",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const response = pm.response.json();",
                  "pm.test('Registro retorna sucesso e JSON', () => { pm.expect(pm.response.code).to.eql(200); pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'); });",
                  "pm.test('Registro retorna token e perfil', () => { pm.expect(response.accessToken).to.be.a('string').and.not.empty; pm.expect(response.user).to.have.property('tenantId'); });",
                  "pm.collectionVariables.set('accessToken', response.accessToken);",
                  "pm.environment.set('accessToken', response.accessToken);",
                  "pm.collectionVariables.set('tenantId', response.user.tenantId);",
                  "pm.collectionVariables.set('userId', response.user.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenantName\": \"Clínica Exemplo\",\n  \"tenantSlug\": \"clinica-exemplo\",\n  \"name\": \"Administrador de Exemplo\",\n  \"email\": \"{{loginEmail}}\",\n  \"password\": \"{{loginPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const response = pm.response.json();",
                  "pm.test('Login retorna sucesso e JSON', () => { pm.expect(pm.response.code).to.eql(200); pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'); });",
                  "pm.test('Login retorna token e perfil', () => { pm.expect(response.accessToken).to.be.a('string').and.not.empty; pm.expect(response.user).to.have.property('tenantId'); });",
                  "pm.collectionVariables.set('accessToken', response.accessToken);",
                  "pm.environment.set('accessToken', response.accessToken);",
                  "pm.collectionVariables.set('tenantId', response.user.tenantId);",
                  "pm.collectionVariables.set('userId', response.user.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{loginEmail}}\",\n  \"password\": \"{{loginPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Usuário autenticado",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/auth/me"
          }
        },
        {
          "name": "Renovar token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const response = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', response.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/auth/refresh"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/auth/logout"
          }
        }
      ]
    },
    {
      "name": "02 — Tenants",
      "description": "Operações de plataforma executadas por PlatformAdmin. O onboarding é transacional e exige valores fictícios únicos.",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}" }] },
      "item": [
        {
          "name": "Listar tenants",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/platform/tenants" }
        },
        {
          "name": "Onboarding de tenant",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const response = pm.response.json();",
                  "pm.test('Onboarding é criado', () => { pm.expect(pm.response.code).to.eql(201); pm.expect(response.tenantId).to.be.a('string'); });",
                  "pm.collectionVariables.set('tenantId', response.tenantId);",
                  "pm.collectionVariables.set('clinicId', response.clinicId);",
                  "pm.collectionVariables.set('unitId', response.unitId);",
                  "pm.collectionVariables.set('userId', response.adminUserId);",
                  "pm.collectionVariables.set('integrationId', response.integrationId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenantName\": \"{{onboardingTenantName}}\",\n  \"tenantSlug\": \"{{onboardingTenantSlug}}\",\n  \"clinicLegalName\": \"Clínica Postman LTDA\",\n  \"clinicTradeName\": \"Clínica Postman\",\n  \"clinicDocument\": \"TEST-POSTMAN\",\n  \"clinicEmail\": \"clinica.postman@example.test\",\n  \"clinicPhone\": \"+550000000101\",\n  \"timeZone\": \"America/Recife\",\n  \"unitName\": \"Unidade Postman\",\n  \"unitAddress\": \"Rua de Teste, 100\",\n  \"unitPhone\": \"+550000000102\",\n  \"adminName\": \"Administrador Postman\",\n  \"adminEmail\": \"admin.postman@example.test\",\n  \"temporaryPassword\": \"{{onboardingTemporaryPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/platform/onboarding"
          }
        },
        {
          "name": "Status do onboarding",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/platform/onboarding/{{tenantId}}"
          }
        },
        {
          "name": "Criar ClinicAdmin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const response = pm.response.json();",
                  "pm.test('ClinicAdmin é criado', () => { pm.expect(pm.response.code).to.eql(200); pm.expect(response.role).to.eql('ClinicAdmin'); pm.expect(response.id).to.be.a('string'); });",
                  "pm.collectionVariables.set('clinicAdminUserId', response.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Clinic Admin Postman\",\n  \"email\": \"clinic-admin.postman@example.test\",\n  \"temporaryPassword\": \"{{onboardingTemporaryPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/platform/tenants/{{tenantId}}/clinic-admins"
          }
        },
        {
          "name": "EXCLUSÃO PERMANENTE do tenant",
          "description": "Use somente em ambiente controlado. Informe o e-mail de um ClinicAdmin ativo e digite exatamente o slug do tenant no campo confirmation.",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"clinicAdminEmail\": \"admin.postman@example.test\",\n  \"confirmation\": \"{{onboardingTenantSlug}}\"\n}" },
            "url": "{{baseUrl}}/api/platform/tenants/{{tenantId}}/purge"
          }
        }
      ]
    },
    {
