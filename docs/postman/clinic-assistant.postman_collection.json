    {
      "name": "09, 10–14 — Scheduling, conversations and WhatsApp",
      "description": "Disponibilidade, bloqueios, férias, reagendamento, templates e operações detalhadas de conversa.",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}" }] },
      "item": [
        { "name": "04 — Units", "item": [
        { "name": "Detalhar unidade", "request": { "method": "GET", "url": "{{baseUrl}}/api/units/{{unitId}}/details" } },
        { "name": "Alterar status da unidade", "request": { "method": "POST", "url": "{{baseUrl}}/api/units/{{unitId}}/status/Inactive" } },
        { "name": "Atualizar horários da unidade", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "[\n  { \"dayOfWeek\": 1, \"opensAt\": \"08:00:00\", \"closesAt\": \"17:00:00\" }\n]" }, "url": "{{baseUrl}}/api/units/{{unitId}}/business-hours" } }
        ] },
        { "name": "08 — Specialties", "item": [
        { "name": "Dependências da especialidade", "request": { "method": "GET", "url": "{{baseUrl}}/api/specialties/{{specialtyId}}/dependencies" } },
        { "name": "Alterar status da especialidade", "request": { "method": "POST", "url": "{{baseUrl}}/api/specialties/{{specialtyId}}/status/Inactive" } }
        ] },
        { "name": "09 — Availability", "item": [
        { "name": "Disponibilidade por data", "request": { "method": "GET", "url": "{{baseUrl}}/api/professionals/{{professionalId}}/availability?date=2026-08-10" } },
        { "name": "Listar regras de disponibilidade", "request": { "method": "GET", "url": "{{baseUrl}}/api/professionals/{{professionalId}}/availability/rules" } },
        { "name": "Adicionar regra de disponibilidade", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"dayOfWeek\": 1,\n  \"startTime\": \"08:00:00\",\n  \"endTime\": \"17:00:00\",\n  \"slotDurationMinutes\": 30,\n  \"active\": true\n}" }, "url": "{{baseUrl}}/api/professionals/{{professionalId}}/availability" } },
        { "name": "Substituir regras de disponibilidade", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "[\n  { \"dayOfWeek\": 1, \"startTime\": \"08:00:00\", \"endTime\": \"17:00:00\", \"slotDurationMinutes\": 30, \"active\": true }\n]" }, "url": "{{baseUrl}}/api/professionals/{{professionalId}}/availability/rules" } },
        { "name": "Listar bloqueios", "request": { "method": "GET", "url": "{{baseUrl}}/api/professionals/{{professionalId}}/blocks" } },
        { "name": "Criar bloqueio", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"startsAt\": \"2026-08-10T12:00:00-03:00\",\n  \"endsAt\": \"2026-08-10T13:00:00-03:00\",\n  \"reason\": \"Bloqueio operacional Postman\"\n}" }, "url": "{{baseUrl}}/api/professionals/{{professionalId}}/blocks" } },
        { "name": "Excluir bloqueio", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/professionals/{{professionalId}}/blocks/{{blockId}}" } },
        { "name": "Listar férias", "request": { "method": "GET", "url": "{{baseUrl}}/api/professionals/{{professionalId}}/vacations" } },
        { "name": "Criar férias", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"startsAt\": \"2026-09-01T08:00:00-03:00\",\n  \"endsAt\": \"2026-09-05T17:00:00-03:00\",\n  \"reason\": \"Férias Postman\"\n}" }, "url": "{{baseUrl}}/api/professionals/{{professionalId}}/vacations" } },
        { "name": "Excluir férias", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/professionals/{{professionalId}}/vacations/{{vacationId}}" } },
        { "name": "Agenda do profissional", "request": { "method": "GET", "url": "{{baseUrl}}/api/professionals/{{professionalId}}/schedule?startsAt=2026-08-10T00:00:00Z&endsAt=2026-08-17T00:00:00Z" } }
        ] },
        { "name": "10 — Appointment operations", "item": [
        { "name": "Cancelar agendamento", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }], "body": { "mode": "raw", "raw": "{\n  \"expectedVersion\": 1,\n  \"reason\": \"Cancelamento administrativo Postman\"\n}" }, "url": "{{baseUrl}}/api/appointments/{{appointmentId}}/cancel" } },
        { "name": "Reagendar agendamento", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }], "body": { "mode": "raw", "raw": "{\n  \"expectedVersion\": 1,\n  \"startsAt\": \"2026-08-11T12:00:00-03:00\",\n  \"endsAt\": \"2026-08-11T12:30:00-03:00\",\n  \"notes\": \"Reagendamento Postman\"\n}" }, "url": "{{baseUrl}}/api/appointments/{{appointmentId}}/reschedule" } }
        ] },
        { "name": "13–14 — WhatsApp integration and templates", "item": [
        { "name": "Configuração Twilio sanitizada", "request": { "method": "GET", "url": "{{baseUrl}}/api/whatsapp/integration/twilio/configuration" } },
        { "name": "Listar templates WhatsApp", "request": { "method": "GET", "url": "{{baseUrl}}/api/whatsapp/templates?page=1&pageSize=25" } },
        { "name": "Detalhar template WhatsApp", "request": { "method": "GET", "url": "{{baseUrl}}/api/whatsapp/templates/{{templateId}}" } },
        { "name": "Criar template WhatsApp", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const response = pm.response.json();", "pm.test('Template é criado', () => { pm.expect(pm.response.code).to.eql(201); pm.expect(response.id).to.be.a('string'); });", "pm.collectionVariables.set('templateId', response.id);"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"contentSid\": \"HX00000000000000000000000000000000\",\n  \"name\": \"lembrete_consulta_postman\",\n  \"languageCode\": \"pt_BR\",\n  \"category\": \"UTILITY\",\n  \"variables\": [\"patientName\"]\n}" }, "url": "{{baseUrl}}/api/whatsapp/templates" } },
        { "name": "Atualizar template WhatsApp", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"contentSid\": \"HX00000000000000000000000000000000\",\n  \"name\": \"lembrete_consulta_postman\",\n  \"languageCode\": \"pt_BR\",\n  \"category\": \"UTILITY\",\n  \"variables\": [\"patientName\", \"appointmentDate\"]\n}" }, "url": "{{baseUrl}}/api/whatsapp/templates/{{templateId}}" } },
        { "name": "Ativar template WhatsApp", "request": { "method": "POST", "url": "{{baseUrl}}/api/whatsapp/templates/{{templateId}}/activate" } },
        { "name": "Desativar template WhatsApp", "request": { "method": "POST", "url": "{{baseUrl}}/api/whatsapp/templates/{{templateId}}/deactivate" } },
        { "name": "Sincronizar templates WhatsApp", "request": { "method": "POST", "url": "{{baseUrl}}/api/whatsapp/templates/sync" } }
        ] },
        { "name": "11 — Conversation operations", "item": [
        { "name": "Listar mensagens da conversa", "request": { "method": "GET", "url": "{{baseUrl}}/api/conversations/{{conversationId}}/messages?page=1&pageSize=100" } },
        { "name": "Marcar mensagem como lida", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"expectedVersion\": 1 }" }, "url": "{{baseUrl}}/api/conversations/{{conversationId}}/messages/{{messageId}}/read" } },
        { "name": "Assumir conversa", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"expectedVersion\": 1 }" }, "url": "{{baseUrl}}/api/conversations/{{conversationId}}/assign" } },
        { "name": "Liberar conversa", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"expectedVersion\": 1 }" }, "url": "{{baseUrl}}/api/conversations/{{conversationId}}/release" } },
        { "name": "Transferir conversa", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"expectedVersion\": 1, \"targetUserId\": \"{{targetUserId}}\", \"reason\": \"Transferência Postman\" }" }, "url": "{{baseUrl}}/api/conversations/{{conversationId}}/transfer" } },
        { "name": "Pausar automação", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"expectedVersion\": 1 }" }, "url": "{{baseUrl}}/api/conversations/{{conversationId}}/automation/pause" } },
        { "name": "Retomar automação", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"expectedVersion\": 1 }" }, "url": "{{baseUrl}}/api/conversations/{{conversationId}}/automation/resume" } },
        { "name": "Alterar prioridade da conversa", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"expectedVersion\": 1, \"priority\": \"High\" }" }, "url": "{{baseUrl}}/api/conversations/{{conversationId}}/priority" } },
        { "name": "Encerrar conversa", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"expectedVersion\": 1 }" }, "url": "{{baseUrl}}/api/conversations/{{conversationId}}/close" } },
        { "name": "Reabrir conversa", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"expectedVersion\": 1 }" }, "url": "{{baseUrl}}/api/conversations/{{conversationId}}/reopen" } },
        { "name": "Usuários atribuíveis da conversa", "request": { "method": "GET", "url": "{{baseUrl}}/api/conversations/operators" } }
        ] },
        { "name": "05 — Platform users", "item": [
        { "name": "Listar usuários da plataforma", "request": { "method": "GET", "url": "{{baseUrl}}/api/platform/users" } }
        ] },
        { "name": "03 — Platform clinics", "item": [
        { "name": "Listar clínicas da plataforma", "request": { "method": "GET", "url": "{{baseUrl}}/api/platform/clinics" } },
        { "name": "Dashboard da plataforma — 30 dias", "request": { "method": "GET", "url": "{{baseUrl}}/api/platform/dashboard?period=30d" } },
        { "name": "Dashboard da plataforma — 7 dias", "request": { "method": "GET", "url": "{{baseUrl}}/api/platform/dashboard?period=7d" } },
        { "name": "Dashboard da plataforma — 90 dias", "request": { "method": "GET", "url": "{{baseUrl}}/api/platform/dashboard?period=90d" } }
        ] },
        { "name": "E2E Flows / Conversational WhatsApp", "item": [
        { "name": "Main Menu — enviar saudação", "request": { "method": "POST", "body": { "mode": "urlencoded", "urlencoded": [{ "key": "Body", "value": "Olá" }, { "key": "MessageSid", "value": "SM-postman-main-menu" }, { "key": "From", "value": "whatsapp:{{twilioTestRecipient}}" }, { "key": "To", "value": "{{twilioWhatsAppFrom}}" }] }, "url": "{{baseUrl}}/api/webhooks/whatsapp/twilio/{{twilioIntegrationKey}}" } },
        { "name": "Natural Language — especialidades", "request": { "method": "POST", "body": { "mode": "urlencoded", "urlencoded": [{ "key": "Body", "value": "quais especialidades vocês têm?" }, { "key": "MessageSid", "value": "SM-postman-specialties" }, { "key": "From", "value": "whatsapp:{{twilioTestRecipient}}" }, { "key": "To", "value": "{{twilioWhatsAppFrom}}" }] }, "url": "{{baseUrl}}/api/webhooks/whatsapp/twilio/{{twilioIntegrationKey}}" } },
        { "name": "Natural Language — disponibilidade", "request": { "method": "POST", "body": { "mode": "urlencoded", "urlencoded": [{ "key": "Body", "value": "tem cardiologista amanhã?" }, { "key": "MessageSid", "value": "SM-postman-availability" }, { "key": "From", "value": "whatsapp:{{twilioTestRecipient}}" }, { "key": "To", "value": "{{twilioWhatsAppFrom}}" }] }, "url": "{{baseUrl}}/api/webhooks/whatsapp/twilio/{{twilioIntegrationKey}}" } },
        { "name": "Global command — menu", "request": { "method": "POST", "body": { "mode": "urlencoded", "urlencoded": [{ "key": "Body", "value": "menu" }, { "key": "MessageSid", "value": "SM-postman-menu" }, { "key": "From", "value": "whatsapp:{{twilioTestRecipient}}" }, { "key": "To", "value": "{{twilioWhatsAppFrom}}" }] }, "url": "{{baseUrl}}/api/webhooks/whatsapp/twilio/{{twilioIntegrationKey}}" } },
        { "name": "Global command — handoff", "request": { "method": "POST", "body": { "mode": "urlencoded", "urlencoded": [{ "key": "Body", "value": "quero falar com alguém" }, { "key": "MessageSid", "value": "SM-postman-handoff" }, { "key": "From", "value": "whatsapp:{{twilioTestRecipient}}" }, { "key": "To", "value": "{{twilioWhatsAppFrom}}" }] }, "url": "{{baseUrl}}/api/webhooks/whatsapp/twilio/{{twilioIntegrationKey}}" } },
        { "name": "Schedule — confirmar consulta", "request": { "method": "POST", "body": { "mode": "urlencoded", "urlencoded": [{ "key": "Body", "value": "sim" }, { "key": "MessageSid", "value": "SM-postman-schedule-confirm" }, { "key": "From", "value": "whatsapp:{{twilioTestRecipient}}" }, { "key": "To", "value": "{{twilioWhatsAppFrom}}" }] }, "url": "{{baseUrl}}/api/webhooks/whatsapp/twilio/{{twilioIntegrationKey}}" } },
        { "name": "Confirm — confirmar presença", "request": { "method": "POST", "body": { "mode": "urlencoded", "urlencoded": [{ "key": "Body", "value": "vou comparecer" }, { "key": "MessageSid", "value": "SM-postman-confirm" }, { "key": "From", "value": "whatsapp:{{twilioTestRecipient}}" }, { "key": "To", "value": "{{twilioWhatsAppFrom}}" }] }, "url": "{{baseUrl}}/api/webhooks/whatsapp/twilio/{{twilioIntegrationKey}}" } },
        { "name": "Cancel — cancelar consulta", "request": { "method": "POST", "body": { "mode": "urlencoded", "urlencoded": [{ "key": "Body", "value": "quero cancelar minha consulta" }, { "key": "MessageSid", "value": "SM-postman-cancel" }, { "key": "From", "value": "whatsapp:{{twilioTestRecipient}}" }, { "key": "To", "value": "{{twilioWhatsAppFrom}}" }] }, "url": "{{baseUrl}}/api/webhooks/whatsapp/twilio/{{twilioIntegrationKey}}" } },
        { "name": "Reschedule — mudar meu horário", "request": { "method": "POST", "body": { "mode": "urlencoded", "urlencoded": [{ "key": "Body", "value": "quero mudar meu horário" }, { "key": "MessageSid", "value": "SM-postman-reschedule" }, { "key": "From", "value": "whatsapp:{{twilioTestRecipient}}" }, { "key": "To", "value": "{{twilioWhatsAppFrom}}" }] }, "url": "{{baseUrl}}/api/webhooks/whatsapp/twilio/{{twilioIntegrationKey}}" } }
        ] }
      ]
    }
  ]
}
