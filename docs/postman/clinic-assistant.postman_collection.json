    {
      "name": "06, 10–12, 15–16 — Operational APIs",
      "description": "Pacientes, agenda, conversas, fila humana, dashboard, auditoria e endpoints de plataforma auxiliares.",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}" }] },
      "item": [
        { "name": "15 — Dashboard", "item": [
        { "name": "Dashboard", "request": { "method": "GET", "url": "{{baseUrl}}/api/dashboard" } }
        ] },
        { "name": "16 — Audit", "item": [
        { "name": "Auditoria", "request": { "method": "GET", "url": "{{baseUrl}}/api/audit?page=1&pageSize=25" } }
        ] },
        { "name": "06 — Patients", "item": [
        { "name": "Listar pacientes", "request": { "method": "GET", "url": "{{baseUrl}}/api/patients" } },
        { "name": "Buscar pacientes", "request": { "method": "GET", "url": "{{baseUrl}}/api/patients/search?search=Ana&page=1&pageSize=25" } },
        { "name": "Criar paciente", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const response = pm.response.json();", "pm.test('Paciente é criado', () => { pm.expect(pm.response.code).to.eql(201); pm.expect(response.id).to.be.a('string'); });", "pm.collectionVariables.set('patientId', response.id);"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Paciente Postman\",\n  \"phone\": \"+5581999999999\",\n  \"email\": \"paciente.postman@example.test\",\n  \"birthDate\": \"1990-01-01\",\n  \"consentStatus\": \"Granted\"\n}" }, "url": "{{baseUrl}}/api/patients" } },
        { "name": "Detalhar paciente", "request": { "method": "GET", "url": "{{baseUrl}}/api/patients/{{patientId}}" } }
        ] },
