{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=clinicassistant;Username=clinicassistant;Password=clinicassistant"
  },
  "RabbitMq": { "Host": "localhost", "Port": 5672, "Username": "guest", "Password": "guest", "VirtualHost": "/", "UseTls": false },
  "Redis": { "Host": "localhost", "Port": 6379 },
  "Jwt": {
    "Issuer": "ClinicAssistant",
    "Audience": "ClinicAssistant.Web",
    "Secret": "development-only-secret-change-before-production-2026",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "PlatformBootstrap": {
    "Enabled": false,
    "Admins": []
  },
  "PasswordRecovery": {
    "Provider": "Disabled",
    "TokenExpirationMinutes": 30,
    "FrontendBaseUrl": "http://localhost:3000",
    "From": "",
    "SmtpHost": "",
    "SmtpPort": 587,
    "SmtpUser": "",
    "SmtpPassword": "",
    "EnableSsl": true
  },
  "WhatsApp": {
    "Provider": "Fake",
    "MaximumRetryAttempts": 3,
    "RequestTimeoutSeconds": 15,
    "RawPayloadRetentionDays": 30,
    "MaxWebhookBodySizeBytes": 1048576,
    "Media": {
      "MaxFileSizeBytes": 10485760,
      "AllowedTypes": "image/jpeg,image/png,application/pdf,audio/ogg"
    },
    "Fake": { "DelayMilliseconds": 100, "FailureMode": "None", "FailureRate": 0 }
  },
  "Conversation": {
    "StateExpirationMinutes": 30,
    "IdleCloseHours": 24,
    "MaximumInvalidAttempts": 3,
    "LockTimeoutSeconds": 10,
    "LockTtlSeconds": 60,
    "MaxOptionsPerMessage": 6,
    "MaxMessageLength": 2000,
    "DefaultLanguage": "pt-BR",
    "ReopenClosedConversations": true
  },
  "Twilio": {
    "AccountSid": "",
    "AuthToken": "",
    "WhatsAppFrom": "",
    "RequestTimeoutSeconds": 15,
    "TrustedProxyAddresses": []
  },
  "Serilog": {
    "MinimumLevel": { "Default": "Information", "Override": { "Microsoft.AspNetCore": "Warning" } }
  }
}
