API_PORT=8080
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_DOMAIN=iarecepcao.com.br
NEXT_PUBLIC_SUPPORT_EMAIL=demo@clinicassistant.local

# Banco principal local. O Twilio Sandbox usa este banco.
DATABASE_TARGET=primary
POSTGRES_DB=clinicassistant
POSTGRES_USER=clinicassistant
POSTGRES_PASSWORD=clinicassistant
POSTGRES_PORT=5432
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=clinicassistant
DATABASE_USER=clinicassistant
DATABASE_PASSWORD=clinicassistant

RABBITMQ_USERNAME=clinicassistant
RABBITMQ_PASSWORD=clinicassistant
RABBITMQ_VIRTUAL_HOST=/
RABBITMQ_USE_TLS=false
RABBITMQ_SERVER_NAME=
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_OUTBOX_BATCH_SIZE=50
RABBITMQ_OUTBOX_POLLING_SECONDS=5
RABBITMQ_MAXIMUM_RETRY_ATTEMPTS=4
RABBITMQ_CONSUMER_PREFETCH_COUNT=20
REDIS_PORT=6379
JWT_ISSUER=ClinicAssistant
JWT_AUDIENCE=ClinicAssistant.Web
JWT_SECRET=development-only-secret-change-before-production-2026
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=14
PASSWORD_RECOVERY_PROVIDER=Disabled
PASSWORD_RECOVERY_TOKEN_EXPIRATION_MINUTES=30
PASSWORD_RECOVERY_FRONTEND_BASE_URL=http://localhost:3000
PASSWORD_RECOVERY_FROM=
PASSWORD_RECOVERY_SMTP_HOST=
PASSWORD_RECOVERY_SMTP_PORT=587
PASSWORD_RECOVERY_SMTP_USER=
PASSWORD_RECOVERY_SMTP_PASSWORD=
PASSWORD_RECOVERY_SMTP_ENABLE_SSL=true
# Secure first-start bootstrap. Keep disabled locally unless explicitly testing it.
PLATFORM_BOOTSTRAP__ENABLED=false
# PLATFORM_BOOTSTRAP__ADMINS__0__EMAIL=<PLATFORM_ADMIN_EMAIL_1>
# PLATFORM_BOOTSTRAP__ADMINS__0__PASSWORD=<SET_IN_SECRET_STORE>
# PLATFORM_BOOTSTRAP__ADMINS__1__EMAIL=<PLATFORM_ADMIN_EMAIL_2>
# PLATFORM_BOOTSTRAP__ADMINS__1__PASSWORD=<SET_IN_SECRET_STORE>
WHATSAPP_PROVIDER=Fake
WHATSAPP_MAXIMUM_RETRY_ATTEMPTS=3
WHATSAPP_REQUEST_TIMEOUT_SECONDS=15
WHATSAPP_RAW_PAYLOAD_RETENTION_DAYS=30
WHATSAPP_MAX_WEBHOOK_BODY_SIZE_BYTES=1048576
WHATSAPP_MEDIA_MAX_FILE_SIZE_BYTES=10485760
WHATSAPP_MEDIA_ALLOWED_TYPES=image/jpeg,image/png,application/pdf,audio/ogg
WHATSAPP_FAKE_DELAY_MILLISECONDS=100
WHATSAPP_FAKE_FAILURE_MODE=None
WHATSAPP_FAKE_FAILURE_RATE=0
CONVERSATION_STATE_EXPIRATION_MINUTES=30
CONVERSATION_IDLE_CLOSE_HOURS=24
CONVERSATION_MAXIMUM_INVALID_ATTEMPTS=3
CONVERSATION_LOCK_TIMEOUT_SECONDS=10
CONVERSATION_LOCK_TTL_SECONDS=60
CONVERSATION_MAX_OPTIONS_PER_MESSAGE=10
CONVERSATION_MAX_MESSAGE_LENGTH=2000
CONVERSATION_DEFAULT_LANGUAGE=pt-BR
CONVERSATION_REOPEN_CLOSED_CONVERSATIONS=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio Sandbox sender shown in the Console. The joined participant is To.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_DISPLAY_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_INCOMING_WEBHOOK_BASE_URL=
TWILIO_STATUS_CALLBACK_BASE_URL=
TWILIO_STATUS_CALLBACK_URL=
TWILIO_REQUEST_TIMEOUT_SECONDS=15
OTEL_EXPORTER_OTLP_ENDPOINT=
# Ambiente padrão local.
ASPNETCORE_ENVIRONMENT=Development
TEST_DATA_ALLOWED_DATABASES=clinicassistant

# Integração criada no banco principal. Preencha somente no .env local.
TWILIO_INTEGRATION_KEY=twilio-local-main
WHATSAPP_TEST_RECIPIENT=+550000000301

# Production overrides (keep commented for local Sandbox tests).
# TWILIO_WHATSAPP_FROM=whatsapp:+5511999999999
# TWILIO_INCOMING_WEBHOOK_BASE_URL=https://api.example.com
# TWILIO_STATUS_CALLBACK_BASE_URL=https://api.example.com

# Overrides para executar test-data/E2E no banco isolado.
# Use estes valores no comando ou em um arquivo separado; não misture com o
# ambiente ativo do Twilio Sandbox.
# ASPNETCORE_ENVIRONMENT=Test
# DATABASE_TARGET=test
# POSTGRES_DB=clinicassistant_test
# DATABASE_NAME=clinicassistant_test
# TEST_DATA_ALLOWED_DATABASES=clinicassistant_test
# TEST_DATA_CONFIRM=YES
# ALLOW_TEST_DATA_RESET=true
# E2E_BASE_DATE=2026-08-03
# E2E_DEFAULT_PASSWORD=ClinicAssistant-E2E-Only-2026
